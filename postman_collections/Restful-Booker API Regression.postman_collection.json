    {
      "name": "06_Partial_Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify the server processed the partial modification successfully\npm.test(\"Partial Update Confirmed - Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Test 2: Assert data integrity - verify first name changed to Ranisha\nvar responseData = pm.response.json();\npm.test(\"Verify first name updated successfully to Ranisha\", function () {\n    pm.expect(responseData.firstname).to.eql(\"Ranisha\");\n});\n"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{adminToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
