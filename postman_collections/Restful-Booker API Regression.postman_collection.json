    {
      "name": "03_Create_Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify the server saved the booking record successfully\npm.test(\"Booking Successfully Created - Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Action: Extract the generated booking ID number and save it globally\nvar responseBody = pm.response.json();\npm.globals.set(\"activeBookingId\", responseBody.bookingid);\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\": \"Alex\",\n    \"lastname\": \"Tester\",\n    \"totalprice\": 250,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2030-01-01\",\n        \"checkout\": \"2030-01-10\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
