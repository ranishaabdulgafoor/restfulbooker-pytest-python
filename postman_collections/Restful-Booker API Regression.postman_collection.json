      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify the login endpoint processed successfully\npm.test(\"Authentication Successful - Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Action: Parse the response data and save the token dynamically\nvar responseData = pm.response.json();\npm.globals.set(\"adminToken\", responseData.token);\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/auth",
          "protocol": "https",
          "host": [
